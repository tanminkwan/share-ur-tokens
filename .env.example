# 에이전트 아레나 설정. 이 파일을 .env로 복사해 값을 채운다. 비워 두면 기본값.

# ===== 플랫폼 (Settings) =====

# 서비스가 듣는 주소
ARENA_HOST=127.0.0.1

# 클라이언트 기본 제한 시간(초)
ARENA_HTTP_TIMEOUT_SEC=60.0

# 이웃 broker 호출 제한 시간(초)
ARENA_NEIGHBOR_TIMEOUT_SEC=10.0

# 서명 요청의 시각 허용 폭(초)
ARENA_SIG_WINDOW_SEC=60.0

# broker 포트
ARENA_BROKER_PORT=9110

# broker 이름
ARENA_BROKER_NAME=broker

# 태초부터 있는 만민 그룹의 식별자(열린 그룹, 선언 없이 쓰임)
ARENA_GENESIS_GROUP_ID=public

# 이 broker가 속한 broker 그룹 식별자(같은 그룹의 broker는 같은 값, 비면 만민 그룹)
ARENA_BROKER_GROUP_ID=

# 이웃 broker 주소(쉼표 구분)
ARENA_BROKER_NEIGHBORS=

# 닫힌 그룹 소유자 공개키(비면 열린 그룹)
ARENA_BROKER_OWNER_PUB=

# broker 키 파일
ARENA_BROKER_KEY_FILE=data/broker.key

# recorder 포트
ARENA_RECORDER_PORT=9120

# recorder 이름
ARENA_RECORDER_NAME=recorder

# 기록자 키 파일
ARENA_RECORDER_KEY_FILE=data/recorder.key

# 원장 파일(JSONL)
ARENA_RECORDER_LEDGER_FILE=data/ledger.jsonl

# 모든 항목이 선언된 broker 그룹의 group_id를 쓰도록 요구할지
ARENA_RECORDER_REQUIRE_GROUP=True

# 전체 열람 허용 공개키(쉼표 구분)
ARENA_RECORDER_READERS=

# 접근 기록 보관 건수
ARENA_ACCESS_LOG_SIZE=50

# 검색 기본 상위 건수
ARENA_SEARCH_K=3

# 검색 최대 건수
ARENA_SEARCH_MAX_K=50

# BM25 k1
ARENA_BM25_K1=1.5

# BM25 b
ARENA_BM25_B=0.75

# 표시용 이름 접두사
ARENA_PEN_NAME_PREFIX=필명-

# 표시용 이름에 쓰는 공개키 글자 수
ARENA_PEN_NAME_LEN=6

# LLM 백엔드: compat(OpenAI 호환, 삼성SDS Cloud AI 서비스) 또는 claude
ARENA_LLM_BACKEND=compat

# OpenAI 호환 엔드포인트 주소
ARENA_LLM_BASE_URL=

# 그 엔드포인트의 API 키
ARENA_LLM_API_KEY=

# Claude API 키(백엔드가 claude일 때)
ARENA_LLM_CLAUDE_API_KEY=

# 비서 에이전트용 모델
ARENA_LLM_MODEL_AGENT=

# 페르소나(사람 역할)용 모델
ARENA_LLM_MODEL_PERSONA=

# LLM 동시 호출 상한
ARENA_LLM_CONCURRENCY=6

# 빈 응답·JSON 아님·HTTP 오류일 때 다시 묻는 횟수
ARENA_LLM_RETRIES=4

# LLM 서비스가 바쁘다고(429, 5xx) 답하면 다시 묻기 전 처음 쉬는 초(매번 두 배)
ARENA_LLM_RETRY_BACKOFF_SEC=2.0

# 다시 묻기 전 한 번에 쉬는 최대 초(서비스의 Retry-After도 이 값으로 자름)
ARENA_LLM_RETRY_MAX_WAIT_SEC=30.0

# 응답 최대 토큰
ARENA_LLM_MAX_TOKENS=6000

# LLM 호출 제한 시간(초)
ARENA_LLM_TIMEOUT_SEC=240.0

# 기본 추론 강도(reasoning_effort)
ARENA_LLM_EFFORT=low

# peer 사이 A2A 호출 제한 시간(초)
ARENA_A2A_TIMEOUT_SEC=120.0

# 프로필 만기(초)
ARENA_PROFILE_TTL_SEC=604800.0

# 프로필 요약에 넣는 공개 영역 최근 줄 수
ARENA_PROFILE_LINES_MAX=12

# 공개 영역에서 경험 노트를 덧붙이는 파일
ARENA_AREA_NOTES_FILE=notes.md

# 이 글자로 시작하는 문서는 소유자 전용
ARENA_AREA_OWNER_PREFIX=_

# 관측 로그 보관 건수
ARENA_EVENT_LOG_SIZE=2000

# 임베딩 서비스 주소(bge-m3, POST /embed)
ARENA_EMBED_URL=

# 임베딩 한 번에 보내는 글 수
ARENA_EMBED_BATCH=32

# 임베딩 호출 제한 시간(초)
ARENA_EMBED_TIMEOUT_SEC=60.0

# 임베딩 실패 시 다시 묻는 횟수
ARENA_EMBED_RETRIES=2

# 검색 peer 색인 갱신 주기(초)
ARENA_SEARCH_SYNC_SEC=5.0

# 검색 peer가 버리는 최소 유사도
ARENA_SEARCH_MIN_SCORE=0.0

# 검색 peer A2A 포트
ARENA_SEARCH_PEER_PORT=9130

# 이벤트가 지정한 앱이 없을 때 물어볼 앱 배포 peer 주소들(쉼표). 비면 자동 설치를 하지 않는다
ARENA_APP_STORE_URLS=

# 설치를 받아 줄 앱 배포자 공개키들(쉼표). 비면 서명만 맞으면 소유자에게 묻는다
ARENA_APP_TRUSTED_PUBLISHERS=

# 앱 꾸러미 원본의 최대 크기(바이트)
ARENA_APP_MAX_SOURCE_BYTES=200000

# 앱 배포 peer가 받은 꾸러미를 보관하는 폴더
ARENA_APP_STORE_DIR=data/app-store

# 앱 배포 peer A2A 포트
ARENA_APP_STORE_PEER_PORT=9150

# 앱 배포 peer 키 파일
ARENA_APP_STORE_PEER_KEY_FILE=data/app-store-peer.key

# 앱 배포 peer 공개 영역 폴더
ARENA_APP_STORE_PEER_AREA=data/areas/app-store-peer

# 앱 배포 peer 라벨
ARENA_APP_STORE_PEER_LABELS=

# 앱 배포 peer가 프로필을 게시할 broker 그룹: 그룹=주소, 쉼표 구분
ARENA_APP_STORE_PEER_BROKERS=

# 재단 peer(코드표 판을 내는 특수 목적 peer) A2A 포트
ARENA_FOUNDATION_PEER_PORT=9170

# 재단 peer 키 파일
ARENA_FOUNDATION_PEER_KEY_FILE=data/foundation-peer.key

# 재단 peer 공개 영역 폴더
ARENA_FOUNDATION_PEER_AREA=data/areas/foundation-peer

# 재단 peer 라벨
ARENA_FOUNDATION_PEER_LABELS=

# 재단 peer가 프로필을 게시할 broker 그룹: 그룹=주소, 쉼표 구분
ARENA_FOUNDATION_PEER_BROKERS=

# 재단 peer가 시작할 때 기본 코드표 판을 기록할 기록자 API 주소(비면 기록하지 않음)
ARENA_FOUNDATION_PEER_RECORDER_URL=

# ARENA_APP_STORE_URLS가 비어 있을 때 broker에서 '앱 배포' 역할의 peer를 찾아 물을지
ARENA_APP_STORE_DISCOVER=False

# 서비스 peer(API를 제공하는 peer) A2A 포트
ARENA_SERVICE_PEER_PORT=9160

# 서비스 peer의 api 연결(REST) 포트
ARENA_SERVICE_PEER_API_PORT=9161

# 서비스 peer가 여는 연결 방식(a2a, api 중에서, 쉼표). api만이면 API 전용 peer
ARENA_SERVICE_PEER_CONNECTIONS=a2a,api

# 평가 요소: 한 번에 평가자에게 넘기는 항목 수 상한
ARENA_EVALUATION_MAX_ITEMS=20

# 이벤트 선언의 일정(schedule) 항목 수 상한
ARENA_EVENT_SCHEDULE_MAX=50

# peer 예약 장치가 한 번에 잠드는 최대 시간(초). 그 사이 새 예약이 생겨도 이만큼 안에 깨어 본다
ARENA_SCHEDULER_MAX_SLEEP_SEC=30.0

# 기본 비서가 이벤트 하나에 스스로 걸 수 있는 예약(remind) 수 상한
ARENA_ASSISTANT_MAX_REMINDERS=5

# 제출 받기 요소: 제출 내용 하나의 최대 크기(바이트)
ARENA_INTAKE_MAX_CONTENT_BYTES=100000

# 프로필에 실을 사람 연락처(human 연결 방식, 예: mailto:, 채팅 주소). 비면 싣지 않는다
ARENA_PEER_HUMAN_CONTACT=

# 서비스 peer 키 파일
ARENA_SERVICE_PEER_KEY_FILE=data/service-peer.key

# 서비스 peer 공개 영역 폴더
ARENA_SERVICE_PEER_AREA=data/areas/service-peer

# 서비스 peer 라벨
ARENA_SERVICE_PEER_LABELS=

# 서비스 peer가 프로필을 게시할 broker 그룹: 그룹=주소, 쉼표 구분
ARENA_SERVICE_PEER_BROKERS=

# 검색 peer 키 파일
ARENA_SEARCH_PEER_KEY_FILE=data/search-peer.key

# 검색 peer 공개 영역 폴더
ARENA_SEARCH_PEER_AREA=data/areas/search-peer

# 검색 peer 라벨(넓을수록 많은 공지를 색인)
ARENA_SEARCH_PEER_LABELS=

# 검색 peer가 색인할 broker 그룹: 그룹=주소, 쉼표 구분
ARENA_SEARCH_PEER_BROKERS=

# god peer A2A 포트
ARENA_GOD_PEER_PORT=9140

# god peer 키 파일
ARENA_GOD_PEER_KEY_FILE=data/god-peer.key

# god peer 공개 영역 폴더
ARENA_GOD_PEER_AREA=data/areas/god-peer

# god peer 라벨
ARENA_GOD_PEER_LABELS=

# god peer가 보는 broker 그룹: 그룹=주소, 쉼표 구분
ARENA_GOD_PEER_BROKERS=

# 관전 결과를 볼 수 있는 공개키(쉼표 구분)
ARENA_GOD_VIEWERS=

# 관전 결과 캐시(초)
ARENA_GOD_CACHE_SEC=1.0

# 공유 흐름 상위 개수
ARENA_GOD_TOP_FLOWS=5

# URL 공개 영역을 다시 가져오기 전 캐시(초)
ARENA_AREA_CACHE_SEC=60.0

# URL 공개 영역 인증 토큰(Bearer, 비면 인증 없음)
ARENA_AREA_HTTP_TOKEN=

# URL 공개 영역 가져오기 제한 시간(초)
ARENA_AREA_HTTP_TIMEOUT_SEC=10.0

# URL 공개 영역의 경험 노트·소유자 메모를 쓰는 로컬 폴더
ARENA_AREA_LOCAL_NOTES_DIR=data/area-notes

# 직접 요청 받은 편지함 크기
ARENA_SOLICIT_INBOX_SIZE=200

# recorder가 공개키별 실적 집계를 공개할지(GET /track/{pub})
ARENA_RECORDER_PUBLIC_TRACK=True

# 제네시스가 있는 원장에서 0번 다음 모든 항목의 payload에 원장 식별자(ledger_id = 제네시스 해시)를 요구할지(서명을 이 원장에 묶음)
ARENA_RECORDER_REQUIRE_LEDGER_ID=True

# 뿌리 신뢰: 이 커뮤니티 원장의 제네시스 항목 해시(원장 밖에 공개된 값). 비면 기록자를 뿌리 값으로 검증하지 않는다
ARENA_TRUST_GENESIS_HASH=

# 뿌리 신뢰: 이 커뮤니티 god의 첫 공개키(원장 밖에 공개된 값)
ARENA_TRUST_GOD_PUB=

# 새 커뮤니티의 제네시스가 시작을 연결할 원래 체인 기록자의 API 주소. 비면 이 제네시스가 원래 체인(뿌리)이다
ARENA_GENESIS_PARENT_RECORDER_URL=

# recorder가 한 이벤트의 원장 항목을 공개 정보로 나열할지(GET /events/{event_id}, 진행 현황)
ARENA_RECORDER_PUBLIC_EVENT_VIEW=True

# 등록(publish)에 붙이는 공개 이름표의 최대 길이
ARENA_LEDGER_LABEL_MAX=40

# 내 실적을 확인할 recorder 주소(쉼표 구분, 쓴 recorder는 자동으로 더해짐)
ARENA_PEER_TRACK_RECORDERS=

# 역량 라벨 자율 갱신을 켤지
ARENA_LABEL_AUTO=True

# 원장 근거 역량 라벨 접두사
ARENA_LABEL_ROLE_PREFIX=역할:

# 지식 근거 역량 라벨 접두사
ARENA_LABEL_FIELD_PREFIX=분야:

# 역할 라벨을 붙이는 최소 계약 수
ARENA_LABEL_ROLE_MIN=1

# 분야 라벨 최대 개수
ARENA_LABEL_FIELD_MAX=5

# 분야 라벨 근거 문장의 최소 길이
ARENA_LABEL_EVIDENCE_MIN_LEN=8

# 분야 표준 목록(쉼표 구분). 비면 자유 이름, 있으면 목록 안의 이름만
ARENA_LABEL_FIELD_VOCAB=

# 제네시스 키·원장·공개 영역 폴더
ARENA_GENESIS_DIR=data/genesis

# 만민 broker 이름
ARENA_GENESIS_BROKER_NAME=genesis-broker

# 만민 broker 포트
ARENA_GENESIS_BROKER_PORT=9100

# 제네시스 기록자 peer A2A 포트
ARENA_GENESIS_RECORDER_PORT=9101

# 제네시스 기록자 recorder API 포트
ARENA_GENESIS_RECORDER_API_PORT=9102

# god peer A2A 포트
ARENA_GENESIS_GOD_PORT=9103

# 기본 비서가 입력 하나에 쓰는 최대 단계 수
ARENA_ASSISTANT_MAX_STEPS=8

# 기본 비서가 LLM에 보여 주는 최근 기록 줄 수
ARENA_ASSISTANT_TRANSCRIPT_MAX=60

# 기본 비서가 게시판의 새 공지를 확인하는 주기(초)
ARENA_ASSISTANT_WATCH_SEC=1.0

# 기본 비서의 추론 강도
ARENA_ASSISTANT_EFFORT=low

# 기본 비서가 보내는 직접 요청의 만기(초)
ARENA_EVENT_REQUEST_TTL_SEC=600.0

# 기본 비서가 올리는 이벤트 공지의 만기(초)
ARENA_EVENT_NOTICE_TTL_SEC=3600.0

# 기본 비서가 참여 중인 이벤트를 저장하는 로컬 폴더(peer별 하위 폴더)
ARENA_EVENT_STORE_DIR=data/events

# broker가 프로필·공지·가입 허가를 저장하는 파일(단독 실행)
ARENA_BROKER_STATE_FILE=data/broker-state.json

# recorder 열람 접근 기록 파일(단독 실행)
ARENA_RECORDER_ACCESS_LOG_FILE=data/recorder-access.jsonl

# secondary broker로 넘어간 뒤 primary를 다시 시도하기까지(초)
ARENA_BROKER_FAILBACK_SEC=30.0

# 열린 이벤트에 입력이 없을 때 기본 비서가 스스로 점검하기까지(초, 점검마다 두 배)
ARENA_ASSISTANT_IDLE_SEC=60.0

# 입력 없이 연달아 하는 점검의 최대 횟수
ARENA_ASSISTANT_IDLE_MAX_CHECKS=5

# 이벤트 배정기가 broker 그룹들의 변경분을 읽는 주기(초)
ARENA_EVENT_WATCH_SEC=1.0

# 기본 비서가 LLM에게 보이는 해시의 짧은 참조 길이(# 뒤 글자 수)
ARENA_ASSISTANT_REF_LEN=10

# 기본 비서가 참여 중인 이벤트의 원장에 다른 사람의 새 기록이 있는지 보는 간격(초)
ARENA_ASSISTANT_LEDGER_WATCH_SEC=3.0

# 기본 비서가 진행 현황(이벤트 원장 기록)으로 보여 주는 최근 항목 수
ARENA_ASSISTANT_PROGRESS_MAX=40
