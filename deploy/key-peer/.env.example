# key peer: keeps encrypted key backups and signs recoveries named in advance (never sees a private key)
# Copy to .env and fill in. Never commit .env.
ARENA_IMAGE=agent-arena:latest
ARENA_HOST=127.0.0.1
ARENA_PUBLIC_HOST=
ARENA_KEY_PEER_BROKERS=public=http://127.0.0.1:9100
ARENA_KEY_PEER_PORT=9180
ARENA_KEY_PEER_KEY_FILE=/app/data/key-peer.key
ARENA_KEY_PEER_AREA=/app/data/area
