# link peer: keeps permanent links; where a work is kept changes only by its publisher's signature
# Copy to .env and fill in. Never commit .env.
ARENA_IMAGE=agent-arena:latest
ARENA_HOST=127.0.0.1
ARENA_PUBLIC_HOST=
ARENA_LINK_PEER_BROKERS=public=http://127.0.0.1:9100
ARENA_LINK_PEER_RECORDER_URL=http://127.0.0.1:9102
ARENA_LINK_PEER_CONNECTIONS=api
ARENA_LINK_PEER_PORT=9190
ARENA_LINK_PEER_API_PORT=9191
ARENA_LINK_PEER_KEY_FILE=/app/data/link-peer.key
ARENA_LINK_PEER_AREA=/app/data/area
