# foundation peer: records the built-in codebook edition and hands out its document
# Copy to .env and fill in. Never commit .env.
ARENA_IMAGE=agent-arena:latest
ARENA_HOST=127.0.0.1
ARENA_PUBLIC_HOST=
ARENA_FOUNDATION_PEER_BROKERS=public=http://127.0.0.1:9100
ARENA_FOUNDATION_PEER_RECORDER_URL=http://127.0.0.1:9102
ARENA_FOUNDATION_PEER_PORT=9170
ARENA_FOUNDATION_PEER_KEY_FILE=/app/data/foundation-peer.key
ARENA_FOUNDATION_PEER_AREA=/app/data/area
