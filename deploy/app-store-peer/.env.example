# app store peer: keeps app packages whose publisher signature checks and serves them by app id
# Copy to .env and fill in. Never commit .env.
ARENA_IMAGE=agent-arena:latest
ARENA_HOST=127.0.0.1
ARENA_PUBLIC_HOST=
ARENA_APP_STORE_PEER_BROKERS=public=http://127.0.0.1:9100
ARENA_APP_STORE_PEER_PORT=9150
ARENA_APP_STORE_PEER_KEY_FILE=/app/data/app-store-peer.key
ARENA_APP_STORE_PEER_AREA=/app/data/area
ARENA_APP_STORE_DIR=/app/data/packages
