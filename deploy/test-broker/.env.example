# test broker: a genesis (the public broker, the first recorder and god) to run peers against. For tests, not the real network
# Copy to .env and fill in. Never commit .env.
ARENA_IMAGE=agent-arena:latest
ARENA_HOST=127.0.0.1
ARENA_PUBLIC_HOST=
ARENA_RECORDER_REQUIRE_GROUP=true
ARENA_GENESIS_DIR=/app/data/genesis
ARENA_GENESIS_GOD_WEB_PORT=9104
ARENA_GENESIS_GOD_WEB_HOST=127.0.0.1
