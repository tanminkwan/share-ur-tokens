# connectivity server settings (connectivity/config.py). Copy to .env and change what you need.
# To serve others: CONNECTIVITY_HOST=0.0.0.0 and CONNECTIVITY_PUBLIC_URL=http://<this server's address>:9200
# For Agent Arena peers, forward only the A2A paths (a peer also filters them on its side).
ARENA_IMAGE=agent-arena:latest

# 듣는 주소(container 안에서는 0.0.0.0)
CONNECTIVITY_HOST=127.0.0.1

# HTTP 포트
CONNECTIVITY_PORT=9200

# 붙은 쪽이 남에게 알릴 주소의 앞부분(예: https://connect.example.com). 비면 http://HOST:PORT
CONNECTIVITY_PUBLIC_URL=

# 동시에 붙을 수 있는 키 수
CONNECTIVITY_MAX_ATTACHED=1000

# 한 키에게 동시에 전달 중인 요청 수 상한
CONNECTIVITY_MAX_INFLIGHT=16

# 출발 IP 하나가 한 키에게 보낼 수 있는 초당 요청 수
CONNECTIVITY_RATE_PER_SEC=20.0

# 요청·응답 body 크기 상한(바이트)
CONNECTIVITY_MAX_BODY_BYTES=1048576

# 전달한 요청의 응답을 기다리는 시간(초)
CONNECTIVITY_REQUEST_TIMEOUT_SEC=30.0

# poll이 없을 때 session을 닫기까지의 시간(초)
CONNECTIVITY_ATTACH_GRACE_SEC=60.0

# poll 하나를 붙들고 기다리는 시간의 상한(초)
CONNECTIVITY_POLL_HOLD_SEC=25.0

# 전달하는 경로(쉼표 구분, 정확히 같아야 함). 비면 모든 경로
CONNECTIVITY_PATHS=/.well-known/agent-card.json,/rpc,/a2a/notify

# 양쪽으로 전달하지 않는 헤더(hop-by-hop 헤더는 늘 버림)
CONNECTIVITY_DROP_HEADERS=cookie,set-cookie

# 붙을 수 있는 공개키 목록 파일(줄마다 하나, #은 주석). 비면 서명이 맞는 누구나
CONNECTIVITY_ALLOW_KEYS_FILE=

# inbound 점검에서 되돌아가 볼 수 있는 사설 대역(CIDR). 비면 공인 주소만
CONNECTIVITY_PROBE_ALLOW=

# 한 키가 inbound 점검을 요청할 수 있는 시간당 횟수
CONNECTIVITY_CHECK_PER_HOUR=30

# inbound 점검에서 되돌아가 보는 제한 시간(초)
CONNECTIVITY_REACH_TIMEOUT_SEC=5.0

# STUN(UDP) 포트. 0이면 열지 않음, 표준은 3478
CONNECTIVITY_STUN_PORT=0

# 서명 시각 허용 폭(초)
CONNECTIVITY_SIG_WINDOW_SEC=60.0

# 앞에 둔 reverse proxy의 X-Forwarded-For를 출발 IP로 믿을지
CONNECTIVITY_TRUST_FORWARDED=false
