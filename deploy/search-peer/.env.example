# search peer: finds peers by embedding vectors (needs an embedding server, ARENA_EMBED_URL)
# Copy to .env and fill in. Never commit .env.
ARENA_IMAGE=agent-arena:latest
ARENA_HOST=127.0.0.1
ARENA_PUBLIC_HOST=
ARENA_SEARCH_PEER_BROKERS=public=http://127.0.0.1:9100
ARENA_EMBED_URL=http://127.0.0.1:8000
ARENA_SEARCH_PEER_PORT=9130
ARENA_SEARCH_PEER_KEY_FILE=/app/data/search-peer.key
ARENA_SEARCH_PEER_AREA=/app/data/area
