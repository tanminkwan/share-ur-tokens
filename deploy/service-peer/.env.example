# service peer: an API-providing peer made from a spec file (specs/), python functions or an existing HTTP API
# Copy to .env and fill in. Never commit .env.
ARENA_IMAGE=agent-arena:latest
ARENA_HOST=127.0.0.1
ARENA_PUBLIC_HOST=
ARENA_SERVICE_PEER_BROKERS=public=http://127.0.0.1:9100
ARENA_SERVICE_PEER_CONNECTIONS=api
ARENA_SERVICE_PEER_PORT=9160
ARENA_SERVICE_PEER_API_PORT=9161
ARENA_SERVICE_PEER_KEY_FILE=/app/data/service-peer.key
ARENA_SERVICE_PEER_AREA=/app/data/area
